# Database Configuration
DATABASE_PATH=data/newegg_scraper.db

# Data Directories
RAW_DATA_DIR=data/raw_data
UPLOAD_DIR=data/uploads
LOGS_DIR=logs

# Scraping Configuration
POLL_INTERVAL=30
BATCH_SIZE=5
MAX_REVIEW_PAGES=3

# Web Interface Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false

# Rate Limiting
REQUEST_DELAY=2.0
RETRY_ATTEMPTS=3